+    // Octopus start - Async player data loading
+    private void load(final ServerAdvancementManager manager, final PlayerAdvancements.LoadedData loadedData) {
+        if (loadedData.progress() != null) {
+            this.applyFrom(manager, new PlayerAdvancements.Data(loadedData.progress()));
+        }
+        if (!loadedData.customSource()) {
+            this.checkForAutomaticTriggers(manager);
+            this.registerListeners(manager);
+        }
