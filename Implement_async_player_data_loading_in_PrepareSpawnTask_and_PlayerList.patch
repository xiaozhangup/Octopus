+    // Octopus start - Async player data loading
+    public java.util.concurrent.CompletableFuture<PlayerList.LoadedPlayerData> loadPlayerDataAsync(final NameAndId nameAndId) {
+        return java.util.concurrent.CompletableFuture.supplyAsync(() -> {
+            UUID uuid = nameAndId.id();
+            GameProfile gameProfile = nameAndId.toUncompletedGameProfile();
+            Path statsFile = this.locateStatsFile(gameProfile);
+            Path advancementsFile = this.server.getWorldPath(LevelResource.PLAYER_ADVANCEMENTS_DIR).resolve(uuid + ".json");
+            return new PlayerList.LoadedPlayerData(
+                this.loadPlayerData(nameAndId),
+                statsFile,
+                ServerStatsCounter.loadStats(this.server, statsFile, uuid.toString()),
+                PlayerAdvancements.loadData(this.server.getFixerUpper(), this, advancementsFile, uuid.toString())
+            );
+        }, net.minecraft.util.Util.ioPool());
+    }
+
+    public void putPreloadedPlayerData(final UUID uuid, final PlayerList.LoadedPlayerData loadedData) {
+        this.preloadedPlayerData.put(uuid, loadedData);
+    }
+
+    public void clearPreloadedPlayerData(final UUID uuid) {
+        this.preloadedPlayerData.remove(uuid);
+    }
+
+    public record LoadedPlayerData(Optional<CompoundTag> playerData, Path statsFile, Map<net.minecraft.stats.Stat<?>, Integer> stats, PlayerAdvancements.LoadedData advancements) {
+    }
+    // Octopus end - Async player data loading
