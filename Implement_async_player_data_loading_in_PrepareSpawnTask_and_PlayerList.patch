+
+    public static PlayerAdvancements.LoadedData loadData(final DataFixer dataFixer, final PlayerList playerList, final Path playerSavePath, final String uuid) {
+        Codec<PlayerAdvancements.Data> codec = DataFixTypes.ADVANCEMENTS.wrapCodec(PlayerAdvancements.Data.CODEC, dataFixer, 1343);
+        return loadData(codec, playerList, playerSavePath, uuid);
+    }
+
+    private static PlayerAdvancements.LoadedData loadData(final Codec<PlayerAdvancements.Data> codec, final PlayerList playerList, final Path playerSavePath, final String uuid) {
+        if (playerList.getServer().achievementsSource != null) {
+            String jsonData = playerList.getServer().achievementsSource.load(uuid);
+            if (jsonData != null) {
+                JsonElement jsonElement = com.google.gson.JsonParser.parseString(jsonData);
+                return new PlayerAdvancements.LoadedData(codec.parse(JsonOps.INSTANCE, jsonElement).getOrThrow(JsonParseException::new).map(), true);
+            }
+            return new PlayerAdvancements.LoadedData(null, true);
+        }
+
+        if (Files.isRegularFile(playerSavePath)) {
+            try (Reader reader = Files.newBufferedReader(playerSavePath, StandardCharsets.UTF_8)) {
+                JsonElement json = StrictJsonParser.parse(reader);
+                return new PlayerAdvancements.LoadedData(codec.parse(JsonOps.INSTANCE, json).getOrThrow(JsonParseException::new).map(), false);
+            } catch (IOException | JsonIOException e) {
+                LOGGER.error("Couldn't access player advancements in {}", playerSavePath, e);
+            } catch (JsonParseException e) {
+                LOGGER.error("Couldn't parse player advancements in {}", playerSavePath, e);
+            }
+        }
+
+        return new PlayerAdvancements.LoadedData(null, false);
+    }
+    // Octopus end - Async player data loading
 
