+    // Octopus start - Async player data loading
+    public static Map<Stat<?>, Integer> loadStats(final MinecraftServer server, final Path file, final String uuid) {
+        if (server.statsSource != null) {
+            String json = server.statsSource.load(uuid);
+            if (json != null) {
+                return parseStats(server.getFixerUpper(), StrictJsonParser.parse(json), file);
+            }
+        } else if (Files.isRegularFile(file)) {
+            try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
+                return parseStats(server.getFixerUpper(), StrictJsonParser.parse(reader), file);
+            } catch (IOException e) {
+                LOGGER.error("Couldn't read statistics file {}", file, e);
+            } catch (JsonParseException e) {
+                LOGGER.error("Couldn't parse statistics file {}", file, e);
+            }
+        }
+
+        return Map.of();
+    }
+    // Octopus end - Async player data loading
