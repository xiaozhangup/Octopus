From: xiaozhangup <xiaozhangshiw@163.com>
Date: Mon, 7 Sep 2026 01:13:52 +0800
Subject: [PATCH] Customize initial spark profiler


diff --git a/src/main/java/io/papermc/paper/SparksFly.java b/src/main/java/io/papermc/paper/SparksFly.java
index 62e2d5704c348955bc8284dc2d54c933b7bcdd06..226f9fcdb75c1c56e0de85d9d339db552d8642b2 100644
--- a/src/main/java/io/papermc/paper/SparksFly.java
+++ b/src/main/java/io/papermc/paper/SparksFly.java
@@ -122,6 +122,7 @@ public final class SparksFly {
             if (GlobalConfiguration.get().spark.enabled) {
                 this.enabled = true;
                 this.spark.enable();
+                this.spark.executeCommand(org.bukkit.Bukkit.getConsoleSender(), new String[]{"profiler", "start", "--thread", "*", "--only-ticks-over", "40"}); // Octopus - customize the initial profiler
             } else {
                 if (!this.disabledInConfigurationWarningLogged) {
                     this.logger.log(Level.INFO, "The spark profiler will not be enabled because it is currently disabled in the configuration.");
