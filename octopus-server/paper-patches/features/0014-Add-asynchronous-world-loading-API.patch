+    // Octopus start - asynchronous world loading
+    @Override
+    public java.util.concurrent.CompletableFuture<@Nullable World> createWorld(WorldCreator creator, boolean async) {
+        if (!async) {
+            return java.util.concurrent.CompletableFuture.completedFuture(this.createWorldSync(creator));
+        }
+        Preconditions.checkArgument(creator != null, "WorldCreator cannot be null");
+
+        me.xiaozhangup.octopus.world.AsyncWorldLoad load = new me.xiaozhangup.octopus.world.AsyncWorldLoad(creator.snapshot());
+        synchronized (this.worldLifecycleLock) {
+            this.asyncWorldLoads.add(load);
+        }
+        if (!this.console.isRunning() || this.console.hasStopped()) {
+            this.abandonWorldLoad(load, new IllegalStateException("Server is stopping"));
+            return load.future;
+        }
+
+        this.console.scheduleOnMain(() -> this.beginWorldLoad(load));
+        return load.future;
+    }
+
+    private void beginWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load) {
+        if (load.finished.get()) {
+            return;
+        }
+
+        WorldCreator creator = load.creator;
+        try {
+            Preconditions.checkState(this.console.isRunning() && !this.console.hasStopped(), "Server is stopping");
+            Preconditions.checkState(this.console.getAllLevels().iterator().hasNext(), "Cannot create additional worlds on STARTUP");
+            World existing = this.reserveAsyncWorld(load);
+            if (existing != null) {
+                this.completeWorldLoad(load, existing);
+                return;
+            }
+
+            ChunkGenerator chunkGenerator = creator.generator();
+            BiomeProvider biomeProvider = creator.biomeProvider();
+            if (chunkGenerator == null) {
+                chunkGenerator = this.getGenerator(creator.name());
+            }
+            if (biomeProvider == null) {
+                biomeProvider = this.getBiomeProvider(creator.name());
+            }
+            Preconditions.checkState(!this.console.options.has("forceUpgrade"), "Asynchronous world loading is unavailable while --forceUpgrade is enabled");
+
+            ChunkGenerator finalChunkGenerator = chunkGenerator;
+            BiomeProvider finalBiomeProvider = biomeProvider;
+            this.console.submitWorldLoad(() -> {
+                me.xiaozhangup.octopus.world.PreparedWorld prepared = this.prepareWorld(creator, finalChunkGenerator, finalBiomeProvider, true);
+                load.prepared = prepared;
+                return prepared;
+            })
+                .whenComplete((prepared, throwable) -> {
+                    if (!this.console.isRunning() || this.console.hasStopped()) {
+                        return;
+                    }
+                    this.console.scheduleOnMain(() -> {
+                        if (throwable != null) {
+                            this.failWorldLoad(load, throwable);
+                        } else {
+                            this.commitWorldLoad(load, prepared);
+                        }
+                    });
+                });
+        } catch (Throwable throwable) {
+            this.failWorldLoad(load, throwable);
+        }
+    }
+
+    private void commitWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load, me.xiaozhangup.octopus.world.PreparedWorld prepared) {
+        if (load.finished.get()) {
+            return;
+        }
+
+        try {
+            Preconditions.checkState(this.console.isRunning() && !this.console.hasStopped(), "Server is stopping");
+            ServerLevel serverLevel = this.createServerLevel(prepared);
+            load.level = serverLevel;
+            load.prepared = null;
+            if (load.finished.get()) {
+                load.level = null;
+                this.discardWorld(serverLevel);
+                return;
+            }
+
+            if (this.getWorld(serverLevel.getWorld().getUID()) != null) {
+                System.out.println("World " + serverLevel.getWorld().key().asString() + " is a duplicate of another world and has been prevented from loading. Please remove or change the duplicated Paper world metadata before loading it again.");
+                load.level = null;
+                this.discardWorld(serverLevel);
+                this.completeWorldLoad(load, null);
+                return;
+            }
+
+            this.console.initWorld(serverLevel, load.creator);
+            serverLevel.setSpawnSettings(true);
+            this.console.submitWorldLoad(() -> {
+                this.console.prepareLevelChunks(serverLevel);
+                return null;
+            }).whenComplete((ignored, throwable) -> {
+                if (!this.console.isRunning() || this.console.hasStopped()) {
+                    return;
+                }
+                this.console.scheduleOnMain(() -> {
+                    if (load.finished.get()) {
+                        return;
+                    }
+                    if (throwable != null) {
+                        this.failWorldLoad(load, throwable);
+                        return;
+                    }
+
+                    try {
+                        Preconditions.checkState(this.console.isRunning() && !this.console.hasStopped(), "Server is stopping");
+                        this.addWorld(serverLevel.getWorld());
+                        Preconditions.checkState(
+                            this.worlds.get(serverLevel.getWorld().getName().toLowerCase(Locale.ROOT)) == serverLevel.getWorld(),
+                            "World %s could not be published",
+                            serverLevel.getWorld().getName()
+                        );
+                        this.console.addLevel(serverLevel);
+                        this.console.finishPreparingLevel(serverLevel);
+                        load.level = null;
+                        this.completeWorldLoad(load, serverLevel.getWorld());
+                    } catch (Throwable finishFailure) {
+                        this.failWorldLoad(load, finishFailure);
+                    }
+                });
+            });
+        } catch (Throwable throwable) {
+            this.failWorldLoad(load, throwable);
+        }
+    }
+
+    private void failWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load, Throwable throwable) {
+        if (!load.finished.compareAndSet(false, true)) {
+            return;
+        }
+
+        me.xiaozhangup.octopus.world.PreparedWorld prepared = load.prepared;
+        load.prepared = null;
+        ServerLevel level = load.level;
+        load.level = null;
+        try {
+            if (level != null) {
+                this.discardWorld(level);
+            } else if (prepared != null) {
+                java.util.Objects.requireNonNull(prepared.savedDataStorage()).discard();
+            }
+        } catch (Throwable closeFailure) {
+            throwable.addSuppressed(closeFailure);
+        } finally {
+            this.releaseWorldLoad(load);
+            load.future.completeExceptionally(throwable);
+        }
+    }
+
+    private void completeWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load, @Nullable World world) {
+        if (!load.finished.compareAndSet(false, true)) {
+            return;
+        }
+        this.releaseWorldLoad(load);
+        load.future.complete(world);
+    }
+
+    private void abandonWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load, Throwable throwable) {
+        if (!load.finished.compareAndSet(false, true)) {
+            return;
+        }
+        this.releaseWorldLoad(load);
+        load.future.completeExceptionally(throwable);
+    }
+
+    private void releaseWorldLoad(me.xiaozhangup.octopus.world.AsyncWorldLoad load) {
+        synchronized (this.worldLifecycleLock) {
+            if (load.reserved) {
+                this.loadingWorldNames.remove(load.creator.name().toLowerCase(Locale.ROOT));
+                this.loadingWorldKeys.remove(load.creator.key());
+                load.reserved = false;
+            }
+            this.asyncWorldLoads.remove(load);
+        }
+    }
+
+    public void cancelWorldLoads(boolean discard) {
+        List<me.xiaozhangup.octopus.world.AsyncWorldLoad> loads;
+        synchronized (this.worldLifecycleLock) {
+            loads = List.copyOf(this.asyncWorldLoads);
+        }
+        for (me.xiaozhangup.octopus.world.AsyncWorldLoad load : loads) {
+            if (discard) {
+                this.failWorldLoad(load, new IllegalStateException("Server is stopping"));
+            } else {
+                this.abandonWorldLoad(load, new IllegalStateException("Server is stopping"));
+            }
+        }
+    }
+
+    private @Nullable World reserveAsyncWorld(me.xiaozhangup.octopus.world.AsyncWorldLoad load) {
+        WorldCreator creator = load.creator;
+        String name = creator.name();
+        String normalizedName = name.toLowerCase(Locale.ROOT);
+        synchronized (this.worldLifecycleLock) {
+            World world = this.getWorld(name);
+            World worldByKey = this.getWorld(creator.key());
+            if (world != null || worldByKey != null) {
+                if (world == worldByKey) {
+                    return world;
+                }
+                throw new IllegalArgumentException("Cannot create a world with key " + creator.key() + " and name " + name + " one (or both) already match a world that exists");
+            }
+
+            Preconditions.checkState(
+                !this.loadingWorldNames.contains(normalizedName) && !this.loadingWorldKeys.contains(creator.key()),
+                "World %s (%s) is already being loaded",
+                name,
+                creator.key()
+            );
+            this.loadingWorldNames.add(normalizedName);
+            this.loadingWorldKeys.add(creator.key());
+            load.reserved = true;
+        }
+        return null;
+    }
