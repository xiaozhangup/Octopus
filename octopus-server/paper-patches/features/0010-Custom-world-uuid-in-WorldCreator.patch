@@ -1200,6 +1200,14 @@ public final class CraftServer implements Server {
             dimensionKey,
             name
         );
+        if (creator.uuid() != null) {
+            loadedWorldData = new PaperWorldLoader.LoadedWorldData(
+                loadedWorldData.bukkitName(),
+                creator.uuid(),
+                loadedWorldData.pdc(),
+                loadedWorldData.levelOverrides()
