+    // Octopus start - Keep extra data when migrating worlds
+    public static void convertWorldContainerInPlace(final Path worldContainer, final HolderLookup.Provider registryAccess) throws IOException {
+        if (!Files.isDirectory(worldContainer)) {
+            throw new IOException("World container does not exist or is not a directory: " + worldContainer);
+        }
+
+        final Path convertRoot = worldContainer.resolve(".convert");
+        Files.createDirectory(convertRoot);
+        boolean complete = false;
+        try {
+            final LevelStorageSource storageSource = LevelStorageSource.createDefault(worldContainer);
+            try (final LevelStorageSource.LevelStorageAccess rootAccess = storageSource.createAccess(".convert")) {
+                try (final var entries = Files.list(worldContainer)) {
+                    for (final Path world : entries.filter(Files::isDirectory).toList()) {
+                        final String worldName = world.getFileName().toString();
+                        if (worldName.equals(".convert")
+                            || !Files.isRegularFile(world.resolve(LevelResource.LEVEL_DATA_FILE.id()))
+                                && !Files.isRegularFile(world.resolve(LevelResource.OLD_LEVEL_DATA_FILE.id()))) {
+                            continue;
+                        }
+
+                        final ArrayList<ResourceKey<Level>> detectedDimensionKeys = detectDimensionKeys(world);
+                        if (detectedDimensionKeys.size() > 1) {
+                            LOGGER.warn("Skipping world storage conversion for {} because multiple dimension directories were found: {}", worldName, detectedDimensionKeys.stream().map(key -> key.identifier().toString()).toList());
+                            continue;
+                        }
+
+                        final ResourceKey<Level> dimensionKey = detectedDimensionKeys.isEmpty() ? Level.OVERWORLD : detectedDimensionKeys.getFirst();
+                        final ResourceKey<LevelStem> stemKey = dimensionKey == Level.NETHER ? LevelStem.NETHER : dimensionKey == Level.END ? LevelStem.END : LevelStem.OVERWORLD;
+                        LOGGER.info("Converting world storage for {}", worldName);
+                        final Path targetRoot = convertRoot.resolve(worldName);
+                        LegacyCraftBukkitWorldMigration.migrate(new WorldMigrationContext(rootAccess, registryAccess, worldName, stemKey, dimensionKey, targetRoot));
+                        Files.move(targetRoot, world);
+                    }
+                }
+            }
+            complete = true;
+        } finally {
+            if (complete) {
+                try (final var paths = Files.walk(convertRoot)) {
+                    for (final Path path : paths.sorted(Comparator.reverseOrder()).toList()) {
+                        Files.deleteIfExists(path);
+                    }
+                }
+            }
+        }
+    }
+
+    private static ArrayList<ResourceKey<Level>> detectDimensionKeys(final Path sourceRoot) {
+        final ArrayList<ResourceKey<Level>> dimensionKeys = new ArrayList<>();
+        if (hasDimensionContent(sourceRoot)) {
+            dimensionKeys.add(Level.OVERWORLD);
+        }
+        if (hasDimensionContent(sourceRoot.resolve("DIM-1"))) {
+            dimensionKeys.add(Level.NETHER);
+        }
+        if (hasDimensionContent(sourceRoot.resolve("DIM1"))) {
+            dimensionKeys.add(Level.END);
+        }
+        return dimensionKeys;
+    }
+
+    private static boolean hasDimensionContent(final Path root) {
+        for (final String directory : WorldMigrationSupport.DIMENSION_DIRECTORIES) {
+            if (Files.isDirectory(root.resolve(directory))) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Octopus end - Keep extra data when migrating worlds
+
