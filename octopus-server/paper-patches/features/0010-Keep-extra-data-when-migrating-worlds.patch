+    // Octopus start - Keep extra data when migrating worlds
+    private static void copyRemainingFiles(final Path sourceRoot, final Path targetRoot) throws IOException {
+        if (sourceRoot.equals(targetRoot) || !Files.isDirectory(sourceRoot)) {
+            return;
+        }
+
+        try (final var entries = Files.list(sourceRoot)) {
+            for (final Path child : entries.toList()) {
+                if (isLegacyRootMetadata(child.getFileName().toString())) {
+                    continue;
+                }
+                copyRemainingFile(child, targetRoot.resolve(child.getFileName().toString()));
+            }
+        }
+    }
+
+    private static boolean isLegacyRootMetadata(final String fileName) {
+        return fileName.equals(LevelResource.LEVEL_DATA_FILE.id())
+            || fileName.equals(LevelResource.OLD_LEVEL_DATA_FILE.id())
+            || fileName.equals("session.lock")
+            || fileName.equals(WorldMigrationSupport.LEGACY_UID_FILE_NAME)
+            || fileName.equals("dimensions");
+    }
+
+    private static void copyRemainingFile(final Path source, final Path target) throws IOException {
+        if (Files.isDirectory(source)) {
+            Files.createDirectories(target);
+            try (final var entries = Files.list(source)) {
+                for (final Path child : entries.toList()) {
+                    copyRemainingFile(child, target.resolve(child.getFileName().toString()));
+                }
+            }
+            return;
+        }
+
+        if (Files.exists(target)) {
+            return;
+        }
+
+        Files.createDirectories(target.getParent());
+        Files.copy(source, target, java.nio.file.StandardCopyOption.COPY_ATTRIBUTES);
+    }
+    // Octopus end - Keep extra data when migrating worlds
+
     private @Nullable Path findExplicitFile(
         final List<Path> dataRoots,
         final String... relativeCandidates
