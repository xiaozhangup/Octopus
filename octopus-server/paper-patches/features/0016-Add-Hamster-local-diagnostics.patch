From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaozhangup <xiaozhangshiw@163.com>
Date: Fri, 2 Oct 2026 13:18:51 +0800
Subject: [PATCH] Add Hamster local diagnostics


diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index 0b35a293f3436bcf8a39c4f07a88340cd9d33bcb..b58271ce5dd03c4e1c727059610a7fc116858900 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -96,6 +96,18 @@ public class GlobalConfiguration extends ConfigurationPart {
         public boolean useDisplayNameInQuitMessage = false;
     }
 
+    // Octopus start - Hamster
+    public Hamster hamster;
+
+    public class Hamster extends ConfigurationPart {
+        @Comment("Record local Hamster JSONL diagnostics. Changes take effect after a restart.")
+        public boolean enabled = true;
+        public String directory = "logs/hamster";
+        public int retentionDays = 7;
+        public int maxDiskMib = 256;
+    }
+    // Octopus end - Hamster
+
     public Spark spark;
 
     public class Spark extends ConfigurationPart {
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
index 8b7a15af1eb2cc0318e26d7199c8e684de63cd72..1ca7eb0a5a0cd090fd9cadb1d003c56a86466570 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperEventManager.java
@@ -65,7 +65,11 @@ class PaperEventManager {
                 }
             } catch (Throwable ex) {
                 String msg = "Could not pass event " + event.getEventName() + " to " + registration.getPlugin().getPluginMeta().getDisplayName();
-                this.server.getLogger().log(Level.SEVERE, msg, ex);
+                // Octopus start - Hamster
+                try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.event(event, registration)) {
+                    this.server.getLogger().log(Level.SEVERE, msg, ex);
+                }
+                // Octopus end - Hamster
                 if (!(event instanceof ServerExceptionEvent)) { // We don't want to cause an endless event loop
                     this.callEvent(new ServerExceptionEvent(new ServerEventException(msg, ex, registration.getPlugin(), registration.getListener(), event)));
                 }
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
index 7b520d3955f271d1dc8b38c3c0fdf0acd3a521a5..30483ee49deaa6294fc5eb76d9ab6cc9f399894a 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
@@ -200,7 +200,11 @@ class PaperPluginInstanceManager {
             try {
                 jPlugin.setEnabled(true);
             } catch (Throwable ex) {
-                this.server.getLogger().log(Level.SEVERE, "Error occurred while enabling " + plugin.getPluginMeta().getDisplayName() + " (Is it up to date?)", ex);
+                // Octopus start - Hamster
+                try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.plugin(plugin, "plugin.enable")) {
+                    this.server.getLogger().log(Level.SEVERE, "Error occurred while enabling " + plugin.getPluginMeta().getDisplayName() + " (Is it up to date?)", ex);
+                }
+                // Octopus end - Hamster
                 // Paper start - Disable plugins that fail to load
                 this.server.getPluginManager().disablePlugin(jPlugin);
                 return;
@@ -235,7 +239,11 @@ class PaperPluginInstanceManager {
             try {
                 javaPlugin.setEnabled(false);
             } catch (Throwable ex) {
-                this.server.getLogger().log(Level.SEVERE, "Error occurred while disabling " + pluginName, ex);
+                // Octopus start - Hamster
+                try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.plugin(plugin, "plugin.disable")) {
+                    this.server.getLogger().log(Level.SEVERE, "Error occurred while disabling " + pluginName, ex);
+                }
+                // Octopus end - Hamster
             }
 
             // Flush async appender before unloading, avoids issues when a log message with class context
@@ -326,7 +334,11 @@ class PaperPluginInstanceManager {
     }
 
     private void handlePluginException(String msg, Throwable ex, Plugin plugin) {
-        Bukkit.getServer().getLogger().log(Level.SEVERE, msg, ex);
+        // Octopus start - Hamster
+        try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.plugin(plugin, "plugin.lifecycle")) {
+            Bukkit.getServer().getLogger().log(Level.SEVERE, msg, ex);
+        }
+        // Octopus end - Hamster
         this.pluginManager.callEvent(new com.destroystokyo.paper.event.server.ServerExceptionEvent(new com.destroystokyo.paper.exception.ServerPluginEnableDisableException(msg, ex, plugin)));
     }
 
diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
index e4e2e42d0ca25df7fe9f2dd4275610e45fcb2c84..c0e8803f0a50c20285619d1d882ac59bd4ec107c 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftAsyncTask.java
@@ -57,13 +57,13 @@ class CraftAsyncTask extends CraftTask {
             super.run();
         } catch (final Throwable t) {
             thrown = t;
-            this.getOwner().getLogger().log(
-                    Level.WARNING,
-                    String.format(
-                        "Plugin %s generated an exception while executing task %s",
-                        this.getOwner().getDescription().getFullName(),
-                        this.getTaskId()),
-                    thrown);
+            // Octopus start - Hamster
+            try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.task(this)) {
+                this.getOwner().getLogger().log(Level.WARNING,
+                    String.format("Plugin %s generated an exception while executing task %s",
+                        this.getOwner().getDescription().getFullName(), this.getTaskId()), thrown);
+            }
+            // Octopus end - Hamster
         } finally {
             // Cleanup is important for any async task, otherwise ghost tasks are everywhere
             synchronized (this.workers) {
diff --git a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
index 7ffb7a210bf840009158d5e4364dad78221ded6c..218958f9cd258f8315938c9e05697748d32c354b 100644
--- a/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
+++ b/src/main/java/org/bukkit/craftbukkit/scheduler/CraftScheduler.java
@@ -478,10 +478,11 @@ public class CraftScheduler implements BukkitScheduler {
                         "Task #%s for %s generated an exception",
                         task.getTaskId(),
                         task.getOwner().getDescription().getFullName());
-                    task.getOwner().getLogger().log(
-                            Level.WARNING,
-                        logMessage,
-                            throwable);
+                    // Octopus start - Hamster
+                    try (var context = me.xiaozhangup.octopus.hamster.HamsterContext.task(task)) {
+                        task.getOwner().getLogger().log(Level.WARNING, logMessage, throwable);
+                    }
+                    // Octopus end - Hamster
                     org.bukkit.Bukkit.getServer().getPluginManager().callEvent(
                         new com.destroystokyo.paper.event.server.ServerExceptionEvent(new com.destroystokyo.paper.exception.ServerSchedulerException(logMessage, throwable, task)));
                     // Paper end
