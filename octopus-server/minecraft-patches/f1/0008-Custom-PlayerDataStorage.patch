     }
 
+    // Octopus start - Custom DataSource
+    @Nullable
+    public <T extends SavedData> T getWithTag(SavedDataType<T> type, CompoundTag tag) {
+        Optional<SavedData> optional = this.cache.get(type);
+        if (optional == null) {
+            optional = Optional.ofNullable(this.readSavedDataWithTag(type, tag));
+            this.cache.put(type, optional);
+        }
+
+        return (T)optional.orElse(null);
+    }
+    // Octopus end - Custom DataSource
+
     @Nullable
     private <T extends SavedData> T readSavedData(SavedDataType<T> type) {
         try {
@@ -98,6 +111,26 @@ public class DimensionDataStorage implements AutoCloseable {
         return null;
     }
 
+    // Octopus start - Custom DataSource
+    @Nullable
+    private <T extends SavedData> T readSavedDataWithTag(SavedDataType<T> type, CompoundTag tag) {
+        try {
+            int dataVersion = NbtUtils.getDataVersion(tag, 1343);
+            CompoundTag tagFixed = type.dataFixType().update(this.fixerUpper, tag, dataVersion, SharedConstants.getCurrentVersion().dataVersion().version());
+            RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
+            return type.codec()
+                    .apply(this.context)
+                    .parse(registryOps, tagFixed.get("data"))
+                    .resultOrPartial(string -> LOGGER.error("Failed to parse saved data for '{}': {}", type, string))
+                    .orElse(null);
+        } catch (Exception var5) {
+            LOGGER.error("Error loading saved data: {}", type, var5);
+        }
+
+        return null;
+    }
+    // Octopus end - Custom DataSource
+
     public <T extends SavedData> void set(SavedDataType<T> type, T value) {
         this.cache.put(type, Optional.of(value));
         value.setDirty();
@@ -185,13 +218,20 @@ public class DimensionDataStorage implements AutoCloseable {
         Map<SavedDataType<?>, CompoundTag> map = new Object2ObjectArrayMap<>();
         RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
         this.cache.forEach((savedDataType, optional) -> optional.filter(SavedData::isDirty).ifPresent(savedData -> {
-            map.put(savedDataType, this.encodeUnchecked(savedDataType, savedData, registryOps));
+            // Octopus start - Custom DataSource
+            me.xiaozhangup.octopus.WorldMapDataSource mapSource = net.minecraft.server.MinecraftServer.getServer().worldMapSource;
+            if (mapSource != null && savedData instanceof net.minecraft.world.level.saveddata.maps.MapItemSavedData) {
+                mapSource.saveMapData(((net.minecraft.world.level.saveddata.maps.MapItemSavedData) savedData).id.id(), this.encodeUnchecked(savedDataType, savedData, registryOps));
+            } else {
+                map.put(savedDataType, this.encodeUnchecked(savedDataType, savedData, registryOps));
+            }
+            // Octopus end - Custom DataSource
             savedData.setDirty(false);
         }));
         return map;
     }
 
-    private <T extends SavedData> CompoundTag encodeUnchecked(SavedDataType<T> type, SavedData data, RegistryOps<Tag> ops) {
+    public <T extends SavedData> CompoundTag encodeUnchecked(SavedDataType<T> type, SavedData data, RegistryOps<Tag> ops) { // Octopus - Custom DataSource
         Codec<T> codec = type.codec().apply(this.context);
         CompoundTag compoundTag = new CompoundTag();
         compoundTag.put("data", codec.encodeStart(ops, (T)data).getOrThrow());
