+    // Octopus start - Skip impossible end exit portal pattern scans
+    private boolean canContainExitPortal(final net.minecraft.core.BlockPos endPodiumLocation, final int maxY) {
+        final int patternSearchOffset = java.lang.Math.max(
+            java.lang.Math.max(this.exitPortalPattern.getWidth(), this.exitPortalPattern.getHeight()), this.exitPortalPattern.getDepth()
+        ) - 1;
+        final int minX = endPodiumLocation.getX() - patternSearchOffset;
+        final int maxX = endPodiumLocation.getX() + patternSearchOffset * 2;
+        final int minZ = endPodiumLocation.getZ() - patternSearchOffset;
+        final int maxZ = endPodiumLocation.getZ() + patternSearchOffset * 2;
+        final int minY = this.level.getMinY();
+        final int maxSearchY = java.lang.Math.min(this.level.getMaxY(), maxY + patternSearchOffset * 2);
+        final net.minecraft.core.BlockPos.MutableBlockPos cursor = new net.minecraft.core.BlockPos.MutableBlockPos();
+        int bedrockBlocks = 0;
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                cursor.set(x, minY, z);
+                if (!this.level.hasChunkAt(cursor)) {
+                    continue;
+                }
+
+                for (int y = minY; y <= maxSearchY; y++) {
+                    cursor.set(x, y, z);
+                    if (this.level.getBlockState(cursor).is(net.minecraft.world.level.block.Blocks.BEDROCK)
+                        && ++bedrockBlocks >= EXIT_PORTAL_PATTERN_BEDROCK_BLOCKS) {
+                        return true;
+                    }
+                }
+            }
+        }
+
+        return false;
+    }
+    // Octopus end - Skip impossible end exit portal pattern scans
+
