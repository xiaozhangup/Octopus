diff --git a/net/minecraft/world/entity/monster/Shulker.java b/net/minecraft/world/entity/monster/Shulker.java
index 8ed256ad6dce91d44d683afdcdf1639c87ba30dc..956c3ee45eaa949ecbcf8f119d5af814150bba93 100644
--- a/net/minecraft/world/entity/monster/Shulker.java
+++ b/net/minecraft/world/entity/monster/Shulker.java
@@ -89,6 +89,10 @@ public class Shulker extends AbstractGolem implements Enemy {
     private @Nullable BlockPos clientOldAttachPosition;
     private int clientSideTeleportInterpolation;
     private static final float MAX_LID_OPEN = 1.0F;
+    // Octopus start - Optimize Shulker teleport
+    private int teleportCooldown = 0;
+    private int consecutiveTeleportFailures = 0;
+    // Octopus end - Optimize Shulker teleport
 
     public Shulker(final EntityType<? extends Shulker> type, final Level level) {
         super(type, level);
@@ -175,6 +179,11 @@ public class Shulker extends AbstractGolem implements Enemy {
     @Override
     public void tick() {
         super.tick();
+        // Octopus start - Optimize Shulker teleport
+        if (this.teleportCooldown > 0) {
+            this.teleportCooldown--;
+        }
+        // Octopus end - Optimize Shulker teleport
         if (!this.level().isClientSide() && !this.isPassenger() && !this.canStayAt(this.blockPosition(), this.getAttachFace())) {
             this.findNewAttachment();
         }
@@ -392,6 +401,11 @@ public class Shulker extends AbstractGolem implements Enemy {
 
     protected boolean teleportSomewhere() {
         if (!this.isNoAi() && this.isAlive()) {
+            // Octopus start - Optimize Shulker teleport
+            if (this.teleportCooldown > 0) {
+                return false;
+            }
+            // Octopus end - Optimize Shulker teleport
             BlockPos oldPos = this.blockPosition();
             Level level = this.level();
 
@@ -425,11 +439,19 @@ public class Shulker extends AbstractGolem implements Enemy {
                         level.levelEvent(LevelEvent.PARTICLES_SHULKER_TELEPORT, oldPos, packedDiff);
                         this.entityData.set(DATA_PEEK_ID, (byte)0);
                         this.setTarget(null);
+                        // Octopus start - Optimize Shulker teleport
+                        this.consecutiveTeleportFailures = 0;
+                        this.teleportCooldown = 0;
+                        // Octopus end - Optimize Shulker teleport
                         return true;
                     }
                 }
             }
 
+            // Octopus start - Optimize Shulker teleport
+            this.consecutiveTeleportFailures++;
+            this.teleportCooldown = Math.min(5, this.consecutiveTeleportFailures);
+            // Octopus end - Optimize Shulker teleport
             return false;
         } else {
             return false;
