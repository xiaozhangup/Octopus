 public class ShulkerBullet extends Projectile {
     private static final double SPEED = 0.15;
+    // Octopus start - ShulkerBullet tick baffle
+    private static final int BAFFLE_RATE = 3;
+    private int tickCounter = 0;
+    // Octopus end - ShulkerBullet tick baffle
     private @Nullable EntityReference<Entity> finalTarget;
     public @Nullable Direction currentMoveDirection;
     public int flightSteps;
@@ -222,9 +226,13 @@ public class ShulkerBullet extends Projectile {
                     )
                 );
             }
+        }
 
+        // Octopus start - ShulkerBullet tick baffle
+        if (!this.level().isClientSide() && (tickCounter % BAFFLE_RATE) == 0) {
             hitResult = ProjectileUtil.getHitResultOnMoveVector(this, this::canHitEntity);
         }
+        // Octopus end - ShulkerBullet tick baffle
 
         Vec3 deltaMovement = this.getDeltaMovement();
         this.setPos(this.position().add(deltaMovement));
@@ -266,6 +274,8 @@ public class ShulkerBullet extends Projectile {
                 }
             }
         }
+
+        tickCounter = (tickCounter + 1) % BAFFLE_RATE; // Octopus - ShulkerBullet tick baffle
     }
 
     @Override
