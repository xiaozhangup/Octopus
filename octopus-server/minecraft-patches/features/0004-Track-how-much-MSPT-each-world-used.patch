From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaozhangup <xiaozhangshiw@163.com>
Date: Wed, 31 Dec 2025 22:05:13 +0800
Subject: [PATCH] Track how much MSPT each world used


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index dad85c1aa5a17c1c565e6889cfdd2c9d1a070091..1eb073ee3f41b467527bd1c8b5cc5b619ab3baf7 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1823,6 +1823,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             // Octopus start
             java.util.concurrent.Callable<Pair<ServerLevel, Throwable>> tickingFunction = () -> {
                 level.worldTaskQueueInstance.acquirePoller();
+                long tickStart = Util.getNanos(); // SparklyPaper - track world's MSPT
                 try {
                     level.tick(haveTime);
                 } catch (Throwable throwable) {
@@ -1832,6 +1833,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                     level.worldTaskQueueInstance.finalizeCyclicalTasks();
                     level.explosionDensityCache.clear(); // Paper - Optimize explosions // Octopus - Move up
                     level.worldTaskQueueInstance.releasePoller();
+                    level.worldTickNanos = Util.getNanos() - tickStart; // Includes scoped and cyclical tasks
                 }
                 return Pair.of(level, null);
             };
@@ -1854,7 +1856,19 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                     result = tickTask.get();
                 }
 
-                result.getLeft().worldTaskQueueInstance.finalizeCallbackTasks(); // Octopus
+                // SparklyPaper start - track world's MSPT
+                // Add only callback execution, excluding executor queueing and waiting for other worlds.
+                ServerLevel level = result.getLeft();
+                long callbackStart = Util.getNanos();
+                try {
+                    level.worldTaskQueueInstance.finalizeCallbackTasks(); // Octopus
+                } finally {
+                    long tickTime = level.worldTickNanos + (Util.getNanos() - callbackStart);
+                    level.tickTimes5s.add(this.tickCount, tickTime);
+                    level.tickTimes10s.add(this.tickCount, tickTime);
+                    level.tickTimes60s.add(this.tickCount, tickTime);
+                }
+                // SparklyPaper end
 
                 Throwable throwable = result.getRight();
 
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 90f96a1d2cc4e1ceea06e012722db42ede35a295..d8e31ce74631f6c35953088c756de0c19109f6c5 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -628,6 +628,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     }
     // Paper end - chunk tick iteration
 
+        // SparklyPaper start - track world's MSPT
+    public long worldTickNanos; // Published to the main thread by WorldTickFutureTask completion
+    public final MinecraftServer.TickTimes tickTimes5s = new MinecraftServer.TickTimes(100);
+    public final MinecraftServer.TickTimes tickTimes10s = new MinecraftServer.TickTimes(200);
+    public final MinecraftServer.TickTimes tickTimes60s = new MinecraftServer.TickTimes(1200);
+    // SparklyPaper end
+
     public ServerLevel(
         final MinecraftServer server,
         final Executor executor,
