+    // Octopus start - asynchronous world loading
+    private volatile Thread worldLoadThread;
+    private final java.util.concurrent.ExecutorService worldLoadExecutor = java.util.concurrent.Executors.newSingleThreadExecutor(task -> {
+        final TickThread wrapped = new TickThread(task, "Octopus World Loader");
+        wrapped.setPriority(6);
+        wrapped.setDaemon(true); // Octopus - asynchronous world loading
+        wrapped.setContextClassLoader(MinecraftServer.class.getClassLoader());
+        this.worldLoadThread = wrapped;
+        return wrapped;
+    });
+
+    public <T> CompletableFuture<T> submitWorldLoad(final Supplier<T> loader) {
+        synchronized (this.stopLock) {
+            if (!this.running || this.hasStopped) {
+                return CompletableFuture.failedFuture(new IllegalStateException("Server is stopping"));
+            }
+
+            try {
+                return CompletableFuture.supplyAsync(() -> {
+                    if (!this.running || this.hasStopped()) {
+                        throw new IllegalStateException("Server is stopping");
+                    }
+                    return loader.get();
+                }, this.worldLoadExecutor);
+            } catch (RejectedExecutionException exception) {
+                return CompletableFuture.failedFuture(exception);
+            }
+        }
+    }
+
+    private boolean awaitWorldLoaderShutdown() {
+        if (Thread.currentThread() == this.worldLoadThread) {
+            return false;
+        }
+
+        final long deadline = Util.getNanos() + java.util.concurrent.TimeUnit.SECONDS.toNanos(30L);
+        boolean interrupted = false;
+        while (!this.worldLoadExecutor.isTerminated() && Util.getNanos() < deadline) {
+            try {
+                this.worldLoadExecutor.awaitTermination(1L, java.util.concurrent.TimeUnit.SECONDS);
+            } catch (InterruptedException exception) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+        if (!this.worldLoadExecutor.isTerminated()) {
+            LOGGER.error("World loader did not stop within 30 seconds; abandoning partial loads during shutdown");
+            return false;
+        }
+        return true;
+    }
+    // Octopus end - asynchronous world loading
     // Octopus end
 
