+    // Octopus start - asynchronous world loading
+    public void prepareLevelChunks(ServerLevel level) {
+        level.worldTaskQueueInstance.acquirePoller();
+        try {
+            ChunkLoadCounter chunkLoadCounter = new ChunkLoadCounter();
+            chunkLoadCounter.track(level, () -> {
+                TicketStorage savedTickets = level.getDataStorage().get(TicketStorage.TYPE);
+                if (savedTickets != null) {
+                    savedTickets.activateAllDeactivatedTickets();
+                }
+            });
+            level.levelLoadListener.start(LevelLoadListener.Stage.LOAD_INITIAL_CHUNKS, chunkLoadCounter.totalChunks());
+            do {
+                if (this.hasStopped() || Thread.currentThread().isInterrupted()) {
+                    throw new java.util.concurrent.CancellationException("Server is stopping");
+                }
+                level.levelLoadListener.update(LevelLoadListener.Stage.LOAD_INITIAL_CHUNKS, chunkLoadCounter.readyChunks(), chunkLoadCounter.totalChunks());
+                level.worldTaskQueueInstance.pollTasks();
+                java.util.concurrent.locks.LockSupport.parkNanos("executing tasks", 1000L);
+            } while (chunkLoadCounter.pendingChunks() > 0);
+            level.levelLoadListener.finish(LevelLoadListener.Stage.LOAD_INITIAL_CHUNKS);
+        } finally {
+            level.worldTaskQueueInstance.releasePoller();
+        }
+    }
+
+    public void finishPreparingLevel(ServerLevel level) {
+        if (Thread.currentThread() != this.serverThread) {
+            throw new IllegalStateException("World loading must finish on the server thread");
+        }
+        level.setSpawnSettings(level.isSpawningMonsters());
+        this.updateEffectiveRespawnData();
+        new org.bukkit.event.world.WorldLoadEvent(level.getWorld()).callEvent();
+    }
+    // Octopus end - asynchronous world loading
