From: Octopus Builder <octopus-builder@example.invalid>
Date: Tue, 2 Jun 2026 22:44:04 +0800
Subject: [PATCH] Limit dropped items per location


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 9e67a9071aeaa2d286d565a45c43e9af20bd471a..a47d45d7cb60c2f641b281b9989d6a3eddcfd2ef 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -923,6 +923,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                         }
                     }
                 );
+            this.trackedItemEntities.clear(); // Octopus - Limit dropped items per location
             if (this.paperConfig().unsupportedSettings.ticking.blockEntities) { // Paper - option to disable ticking
             profiler.popPush("blockEntities");
             this.tickBlockEntities();
diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
index 974d1d7b283aace71f0ea8ef07ba68a17b75af8a..e16b1af30ab44a44fcfbdc1629557bcef8d91bcb 100644
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -149,6 +149,18 @@ public class ItemEntity extends Entity implements TraceableEntity {
 
     @Override
     public void tick() {
+        // Octopus start - Limit dropped items per location
+        int counter = this.level().trackedItemEntities.get(this.blockPosition().asLong());
+        if (counter > 72 && this.getDeltaMovement().lengthSqr() < 1.0E-6) {
+            if ((this.totalEntityAge & 1) == 0) {
+                this.level().trackedItemEntities.addTo(this.blockPosition().asLong(), 1);
+                if (this.pickupDelay > 0 && this.pickupDelay != 32767) {
+                    this.pickupDelay--;
+                }
+                return;
+            }
+        }
+        // Octopus end - Limit dropped items per location
         if (this.getItem().isEmpty()) {
             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
         } else {
@@ -201,6 +213,12 @@ public class ItemEntity extends Entity implements TraceableEntity {
                 }
             }
 
+            // Octopus start - Limit dropped items per location
+            if ((counter > 864 || (counter > 256 && this.totalEntityAge > 20 * 30)) && this.getDeltaMovement().lengthSqr() < 1.0E-6) {
+                this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN);
+                return;
+            }
+            // Octopus end - Limit dropped items per location
             boolean moved = Mth.floor(this.xo) != Mth.floor(this.getX())
                 || Mth.floor(this.yo) != Mth.floor(this.getY())
                 || Mth.floor(this.zo) != Mth.floor(this.getZ());
@@ -230,6 +248,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
                 // CraftBukkit end
                 this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
             }
+            this.level().trackedItemEntities.addTo(this.blockPosition().asLong(), 1); // Octopus - Limit dropped items per location
         }
     }
 
diff --git a/net/minecraft/world/level/Level.java b/net/minecraft/world/level/Level.java
index 56659181dc817ea028428eabf5937308c04b8cc5..f37630bb448ccfc98e44d1218c385d473157bd57 100644
--- a/net/minecraft/world/level/Level.java
+++ b/net/minecraft/world/level/Level.java
@@ -156,6 +156,7 @@ public abstract class Level implements LevelAccessor, AutoCloseable, ca.spottedl
     @Nullable
     public List<net.minecraft.world.entity.item.ItemEntity> captureDrops;
     public final it.unimi.dsi.fastutil.objects.Object2LongOpenHashMap<SpawnCategory> ticksPerSpawnCategory = new it.unimi.dsi.fastutil.objects.Object2LongOpenHashMap<>();
+    public final it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap trackedItemEntities = new it.unimi.dsi.fastutil.longs.Long2IntOpenHashMap(); // Octopus - Limit dropped items per location
     // Paper start - EAR 2
     public int wakeupInactiveRemainingAnimals;
     public int wakeupInactiveRemainingFlying;
