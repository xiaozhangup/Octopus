From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaozhangup <xiaozhangshiw@163.com>
Date: Sat, 29 Aug 2026 02:38:32 +0800
Subject: [PATCH] Resend full clock state one tick after login


diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 59e1c1b90f66f633110548a690cb17628c9e71eb..0e407997c3ce347ff7a9cdd5757fc05fbb9ac794 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -309,6 +309,13 @@ public abstract class PlayerList {
         player.initInventoryMenu();
         this.server.notificationManager().playerJoined(player);
         playerConnection.resumeFlushing();
+        // Octopus start - Resend full clock state one tick after login
+        this.server.scheduleOnMain(() -> {
+            if (playerConnection.isAcceptingMessages()) {
+                playerConnection.send(player.level().clockManager().createFullSyncPacket(player));
+            }
+        });
+        // Octopus end - Resend full clock state one tick after login
         // Paper start - Configurable player collision; Add to collideRule team if needed
         final net.minecraft.world.scores.Scoreboard scoreboard = this.getServer().getLevel(Level.OVERWORLD).getScoreboard();
         final PlayerTeam collideRuleTeam = scoreboard.getPlayerTeam(this.collideRuleTeamName);
