@@ -85,6 +88,25 @@ public class SavedDataStorage implements AutoCloseable {
 
     private <T extends SavedData> @Nullable T readSavedData(final SavedDataType<T> type) {
         try {
+            // Octopus start - Custom DataSource
+            net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+            me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+            Integer mapId = this.getMapId(type);
+            if (mapSource != null && mapId != null) {
+                Optional<CompoundTag> sourceData = mapSource.getMapData(mapId);
+                if (sourceData.isEmpty()) {
+                    return null;
+                }
+
+                int dataVersion = NbtUtils.getDataVersion(sourceData.get(), 1343);
+                CompoundTag fixedTag = type.dataFixType().update(this.fixerUpper, sourceData.get(), dataVersion, SharedConstants.getCurrentVersion().dataVersion().version());
+                RegistryOps<Tag> ops = this.registries.createSerializationContext(NbtOps.INSTANCE);
+                return type.codec()
+                    .parse(ops, fixedTag.get("data"))
+                    .resultOrPartial(error -> LOGGER.error("Failed to parse saved data for '{}': {}", type, error))
+                    .orElse(null);
+            }
+            // Octopus end - Custom DataSource
             Path file = this.getDataFile(type.id());
             if (Files.exists(file)) {
                 CompoundTag tag = this.readTagFromDisk(file, type.dataFixType(), SharedConstants.getCurrentVersion().dataVersion().version());
@@ -148,6 +170,9 @@ public class SavedDataStorage implements AutoCloseable {
