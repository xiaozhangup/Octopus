@@ -77,6 +77,25 @@ public class DimensionDataStorage implements AutoCloseable {
 
     private <T extends SavedData> @Nullable T readSavedData(SavedDataType<T> type) {
         try {
+            // Octopus start - Custom DataSource
+            net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+            me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+            Integer mapId = this.getMapId(type);
+            if (mapSource != null && mapId != null) {
+                Optional<CompoundTag> sourceData = mapSource.getMapData(mapId);
+                if (sourceData.isEmpty()) {
+                    return null;
+                }
+
+                int dataVersion = NbtUtils.getDataVersion(sourceData.get(), 1343);
+                CompoundTag tagFixed = type.dataFixType().update(this.fixerUpper, sourceData.get(), dataVersion, SharedConstants.getCurrentVersion().dataVersion().version());
+                RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
+                return type.codec()
+                    .parse(registryOps, tagFixed.get("data"))
+                    .resultOrPartial(string -> LOGGER.error("Failed to parse saved data for '{}': {}", type, string))
+                    .orElse(null);
+            }
+            // Octopus end - Custom DataSource
             Path dataFile = this.getDataFile(type.id());
             if (Files.exists(dataFile)) {
                 CompoundTag tagFromDisk = this.readTagFromDisk(type.id(), type.dataFixType(), SharedConstants.getCurrentVersion().dataVersion().version());
@@ -176,6 +195,25 @@ public class DimensionDataStorage implements AutoCloseable {
         }
     }
 
+    // Octopus start - Custom DataSource
+    public void saveMapDataImmediately(net.minecraft.world.level.saveddata.maps.MapId mapId, net.minecraft.world.level.saveddata.maps.MapItemSavedData mapData) {
+        net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+        if (mapSource == null) {
+            return;
+        }
+
+        RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
+        CompoundTag tag = this.encodeUnchecked(net.minecraft.world.level.saveddata.maps.MapItemSavedData.type(mapId), mapData, registryOps);
+        mapData.setDirty(false);
+        try {
+            mapSource.saveMapData(mapId.id(), tag);
+        } catch (Exception exception) {
+            LOGGER.error("Could not save map data to custom data source: {}", mapId, exception);
+        }
+    }
+    // Octopus end - Custom DataSource
+
     private Map<SavedDataType<?>, CompoundTag> collectDirtyTagsToSave() {
         Map<SavedDataType<?>, CompoundTag> map = new Object2ObjectArrayMap<>();
         RegistryOps<Tag> registryOps = this.registries.createSerializationContext(NbtOps.INSTANCE);
@@ -195,6 +233,19 @@ public class DimensionDataStorage implements AutoCloseable {
     }
 
     private void tryWrite(SavedDataType<?> type, CompoundTag tag) {
+        // Octopus start - Custom DataSource
+        net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+        Integer mapId = this.getMapId(type);
+        if (mapSource != null && mapId != null) {
+            try {
+                mapSource.saveMapData(mapId, tag);
+            } catch (Exception exception) {
+                LOGGER.error("Could not save map data to custom data source: {}", type, exception);
+            }
+            return;
+        }
+        // Octopus end - Custom DataSource
         Path dataFile = this.getDataFile(type.id());
 
         try {
@@ -204,6 +255,21 @@ public class DimensionDataStorage implements AutoCloseable {
         }
     }
 
+    // Octopus start - Custom DataSource
+    private @Nullable Integer getMapId(SavedDataType<?> type) {
+        String id = type.id();
+        if (!id.startsWith("map_")) {
+            return null;
+        }
+
+        try {
+            return Integer.parseInt(id.substring("map_".length()));
+        } catch (NumberFormatException exception) {
+            return null;
+        }
+    }
+    // Octopus end - Custom DataSource
+
     public void saveAndJoin() {
         this.scheduleSave().join();
     }
