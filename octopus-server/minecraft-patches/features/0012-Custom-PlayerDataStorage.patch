         Path path = this.getDataFile(type.id());
 
         try {
@@ -214,6 +252,65 @@ public class SavedDataStorage implements AutoCloseable {
         }
     }
 
+    // Octopus start - Custom DataSource
+    public void queueMapDataSave(final net.minecraft.world.level.saveddata.maps.MapId mapId, final net.minecraft.world.level.saveddata.maps.MapItemSavedData mapData) {
+        this.pendingMapDataSaves.put(mapId.id(), mapData);
+    }
+
+    public void flushPendingMapDataSaves() {
+        net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+        if (this.pendingMapDataSaves.isEmpty()) {
+            return;
+        }
+        if (mapSource == null) {
+            this.pendingMapDataSaves.clear();
+            return;
+        }
+
+        it.unimi.dsi.fastutil.ints.Int2ObjectMap<net.minecraft.world.level.saveddata.maps.MapItemSavedData> pending = new it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap<>(this.pendingMapDataSaves);
+        this.pendingMapDataSaves.clear();
+        for (it.unimi.dsi.fastutil.ints.Int2ObjectMap.Entry<net.minecraft.world.level.saveddata.maps.MapItemSavedData> entry : pending.int2ObjectEntrySet()) {
+            this.saveMapDataImmediately(new net.minecraft.world.level.saveddata.maps.MapId(entry.getIntKey()), entry.getValue());
+        }
+    }
+
+    public void saveMapDataImmediately(final net.minecraft.world.level.saveddata.maps.MapId mapId, final net.minecraft.world.level.saveddata.maps.MapItemSavedData mapData) {
+        net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
+        me.xiaozhangup.octopus.WorldMapDataSource mapSource = server.worldMapSource;
+        if (mapSource == null) {
+            return;
+        }
+
+        RegistryOps<Tag> ops = this.registries.createSerializationContext(NbtOps.INSTANCE);
+        CompoundTag tag = this.encodeUnchecked(net.minecraft.world.level.saveddata.maps.MapItemSavedData.type(mapId), mapData, ops);
+        mapData.setDirty(false);
+        try {
+            mapSource.saveMapData(mapId.id(), tag);
+        } catch (Exception e) {
+            LOGGER.error("Could not save map data to custom data source: {}", mapId, e);
+        }
+    }
+
+    public void clearMapDataCache(final int mapId) {
+        this.pendingMapDataSaves.remove(mapId);
+        this.cache.remove(net.minecraft.world.level.saveddata.maps.MapItemSavedData.type(new net.minecraft.world.level.saveddata.maps.MapId(mapId)));
+    }
+
+    private @Nullable Integer getMapId(final SavedDataType<?> type) {
+        String path = type.id().getPath();
+        if (!path.startsWith("maps/") || path.equals("maps/last_id")) {
+            return null;
+        }
+
+        try {
+            return Integer.parseInt(path.substring("maps/".length()));
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+    // Octopus end - Custom DataSource
+
     public void saveAndJoin() {
         this.scheduleSave().join();
     }
