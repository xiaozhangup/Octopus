From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaozhangup <xiaozhangshiw@163.com>
Date: Wed, 31 Dec 2025 22:50:35 +0800
Subject: [PATCH] Add EndPortalCreateEvent


diff --git a/net/minecraft/world/item/EnderEyeItem.java b/net/minecraft/world/item/EnderEyeItem.java
index c0e57166efba48688d553ce50d4d0ff98fec668c..7a5b65cc0cadadfe253aaf601f5f14d35a4912f3 100644
--- a/net/minecraft/world/item/EnderEyeItem.java
+++ b/net/minecraft/world/item/EnderEyeItem.java
@@ -64,8 +64,15 @@ public class EnderEyeItem extends Item {
             for (int x = 0; x < 3; x++) {
                 for (int z = 0; z < 3; z++) {
                     BlockPos portalBlockPos = blockPos.offset(x, 0, z);
-                    level.destroyBlock(portalBlockPos, true, null);
-                    level.setBlock(portalBlockPos, Blocks.END_PORTAL.defaultBlockState(), Block.UPDATE_CLIENTS);
+                    // Octopus start - Add EndPortalCreateEvent
+                    org.bukkit.block.Block block = level.getWorld().getBlockAt(portalBlockPos.getX(), portalBlockPos.getY(), portalBlockPos.getZ());
+                    org.bukkit.event.block.EndPortalCreateEvent event = new org.bukkit.event.block.EndPortalCreateEvent(block, block);
+                    level.getCraftServer().getPluginManager().callEvent(event);
+                    if (!event.isCancelled()) {
+                        level.destroyBlock(portalBlockPos, true, null);
+                        level.setBlock(portalBlockPos, Blocks.END_PORTAL.defaultBlockState(), Block.UPDATE_CLIENTS);
+                    }
+                    // Octopus end - Add EndPortalCreateEvent
                 }
             }
 
