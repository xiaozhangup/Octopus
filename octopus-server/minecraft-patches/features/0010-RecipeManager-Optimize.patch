From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xiaozhangup <xiaozhangshiw@163.com>
Date: Wed, 31 Dec 2025 22:10:29 +0800
Subject: [PATCH] RecipeManager Optimize


diff --git a/net/minecraft/world/item/crafting/RecipeManager.java b/net/minecraft/world/item/crafting/RecipeManager.java
index d9ac0c84285c96df934d8649ea659ab11925cb9a..d631a41874f839152a6c24284aa5ae9ed797d9bb 100644
--- a/net/minecraft/world/item/crafting/RecipeManager.java
+++ b/net/minecraft/world/item/crafting/RecipeManager.java
@@ -136,7 +136,16 @@ public class RecipeManager implements RecipeAccess {
     }
 
     public <I extends RecipeInput, T extends Recipe<I>> Optional<RecipeHolder<T>> getRecipeFor(final RecipeType<T> type, final I input, final Level level) {
-        return this.recipes.getRecipesFor(type, input, level).reduce((first, second) -> second.runtimeAddedRecipe() ? second : first); // Paper - prioritize runtime added recipes and prioritize these by insertion order.
+        // Octopus start - preserve Paper recipe priority without streams
+        List<RecipeHolder<T>> list = this.recipes.getRecipesForList(type, input, level);
+        RecipeHolder<T> selected = null;
+        for (RecipeHolder<T> recipe : list) {
+            if (selected == null || recipe.runtimeAddedRecipe()) {
+                selected = recipe;
+            }
+        }
+        return Optional.ofNullable(selected);
+        // Octopus end
     }
 
     public Optional<RecipeHolder<?>> byKey(final ResourceKey<Recipe<?>> recipeId) {
diff --git a/net/minecraft/world/item/crafting/RecipeMap.java b/net/minecraft/world/item/crafting/RecipeMap.java
index b6142dc1f3b8b358965c16dcacf5a5979470b239..c4f77e8de1ea509da162e09afa43ac71ed98df5b 100644
--- a/net/minecraft/world/item/crafting/RecipeMap.java
+++ b/net/minecraft/world/item/crafting/RecipeMap.java
@@ -77,4 +77,24 @@ public class RecipeMap {
     public <I extends RecipeInput, T extends Recipe<I>> Stream<RecipeHolder<T>> getRecipesFor(final RecipeType<T> type, final I container, final Level level) {
         return container.isEmpty() ? Stream.empty() : this.byType(type).stream().filter(r -> r.value().matches(container, level));
     }
+
+    // DivineMC start - Carpet-Fixes - Remove streams to be faster
+    public <I extends RecipeInput, T extends Recipe<I>> java.util.List<RecipeHolder<T>> getRecipesForList(RecipeType<T> type, I input, Level world) {
+        java.util.List<RecipeHolder<T>> list;
+
+        if (input.isEmpty()) {
+            return java.util.List.of();
+        } else {
+            list = new java.util.ArrayList<>();
+        }
+
+        for (RecipeHolder<T> recipeholder : this.byType(type)) {
+            if (recipeholder.value().matches(input, world)) {
+                list.add(recipeholder);
+            }
+        }
+
+        return list;
+    }
+    // DivineMC end - Carpet-Fixes - Remove streams to be faster
 }
