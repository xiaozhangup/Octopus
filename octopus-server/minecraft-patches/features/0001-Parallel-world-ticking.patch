@@ -182,6 +182,12 @@ public final class MoonriseRegionFileIO {
         long failures = 1L; // start at 0.13ms
 
         while (taskController.hasTasks()) {
+            // Octopus start - Parallel world ticking
+            if (pollWorldTasks(world)) {
+                failures = 1L;
+                continue;
+            }
+            // Octopus end - Parallel world ticking
             Thread.yield();
             failures = ConcurrentUtil.linearLongBackoff(failures, 125_000L, 5_000_000L); // 125us, 5ms
         }
@@ -195,6 +201,12 @@ public final class MoonriseRegionFileIO {
             }
 
             if (totalTasks > (long)tasksRemaining) {
+                // Octopus start - Parallel world ticking
+                if (pollWorldTasks(world)) {
+                    failures = 1L;
+                    continue;
+                }
+                // Octopus end - Parallel world ticking
                 Thread.yield();
                 failures = ConcurrentUtil.linearLongBackoff(failures, 125_000L, 5_000_000L); // 125us, 5ms
             } else {
@@ -203,6 +215,12 @@ public final class MoonriseRegionFileIO {
         }
     }
 
+    // Octopus start - Parallel world ticking
+    private static boolean pollWorldTasks(final ServerLevel world) {
+        return TickThread.isTickThread() && world.worldTaskQueueInstance.pollTasks();
+    }
+    // Octopus end - Parallel world ticking
+
     /**
      * Returns the priority associated with blocking I/O based on the current thread. The goal is to avoid
      * dumb plugins from taking away priority from threads we consider crucial.
