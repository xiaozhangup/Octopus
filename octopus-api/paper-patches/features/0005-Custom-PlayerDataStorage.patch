From: xiaozhangup <xiaozhangshiw@163.com>
Date: Wed, 31 Dec 2025 23:12:06 +0800
Subject: [PATCH] Custom PlayerDataStorage


diff --git a/src/main/java/org/bukkit/Server.java b/src/main/java/org/bukkit/Server.java
index 62341f72e8457c5547994bee1f3fda9faade6ce0..2b4b2d3e7307920cc96186737694d5f08ce82693 100644
--- a/src/main/java/org/bukkit/Server.java
+++ b/src/main/java/org/bukkit/Server.java
@@ -2776,4 +2776,36 @@ public interface Server extends PluginMessageRecipient, net.kyori.adventure.audi
      */
     void allowPausing(@NotNull org.bukkit.plugin.Plugin plugin, boolean value);
     // Paper end - API to check if the server is sleeping
+
+    // Octopus start - Custom DataSource
+    /**
+     * Sets the profile source for the server.
+     * @param source
+     */
+    void setProfileSource(@Nullable me.xiaozhangup.octopus.ProfileSource source);
+
+    /**
+     * Sets the stats source for the server.
+     * @param source
+     */
+    void setStatsSource(@Nullable me.xiaozhangup.octopus.JsonDataSource source);
+
+    /**
+     * Sets the achievements source for the server.
+     * @param source
+     */
+    void setAchievementsSource(@Nullable me.xiaozhangup.octopus.JsonDataSource source);
+
+    /**
+     * Sets the maps source for the server.
+     * @param source
+     */
+    void setMapSource(@Nullable me.xiaozhangup.octopus.MapSource source);
+
+    /**
+     * Clears the cached map data for the given map id.
+     * @param mapId the map id
+     */
+    void clearMapCache(int mapId);
+    // Octopus end - Custom DataSource
 }
