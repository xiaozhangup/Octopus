Subject: [PATCH] Custom world uuid in WorldCreator


diff --git a/src/main/java/org/bukkit/WorldCreator.java b/src/main/java/org/bukkit/WorldCreator.java
index 6fb3c2fa739f09f60d94de48716e6a6bb0658e51..70138f614e1c71f15deab798937ec0182e0e9461 100644
--- a/src/main/java/org/bukkit/WorldCreator.java
+++ b/src/main/java/org/bukkit/WorldCreator.java
@@ -2,6 +2,7 @@ package org.bukkit;
 
 import com.google.common.base.Preconditions;
 import java.util.Random;
+import java.util.UUID;
 import io.papermc.paper.math.Position;
 import org.bukkit.command.CommandSender;
 import org.bukkit.generator.BiomeProvider;
@@ -17,6 +18,7 @@ import org.jetbrains.annotations.Nullable;
 public class WorldCreator {
     private final NamespacedKey key; // Paper
     private final String name;
+    private final @Nullable UUID uuid; // Octopus
     private long seed;
     private World.Environment environment = World.Environment.NORMAL;
     private ChunkGenerator generator = null;
@@ -40,7 +42,7 @@ public class WorldCreator {
      */
     @ApiStatus.Obsolete
     public WorldCreator(@NotNull String name) {
-        this(name, null);
+        this(name, null, null);
     }
 
     private static NamespacedKey defaultWorldKey(String name) {
@@ -74,6 +76,10 @@ public class WorldCreator {
      */
     @Deprecated(since = "26.1")
     public WorldCreator(@Nullable String levelName, @Nullable NamespacedKey worldKey) {
+        this(levelName, worldKey, null);
+    }
+
+    private WorldCreator(@Nullable String levelName, @Nullable NamespacedKey worldKey, @Nullable UUID uuid) {
         if (levelName == null && worldKey == null) {
             throw new IllegalArgumentException("World name and key cannot both be null");
         }
@@ -83,6 +89,7 @@ public class WorldCreator {
         this.name = levelName == null ? nameFromKey(worldKey) : levelName;
         this.seed = (new Random()).nextLong();
         this.key = worldKey == null ? defaultWorldKey(levelName) : worldKey;
+        this.uuid = uuid;
     }
 
     /**
@@ -95,7 +102,17 @@ public class WorldCreator {
      * @param worldKey NamespacedKey of the world that will be created
      */
     public WorldCreator(@NotNull NamespacedKey worldKey) {
-        this(null, worldKey);
+        this(null, worldKey, null);
+    }
+
+    /**
+     * Creates an empty WorldCreator for the given key and UUID.
+     *
+     * @param worldKey NamespacedKey of the world that will be created
+     * @param uuid UUID of the world that will be created
+     */
+    public WorldCreator(@NotNull NamespacedKey worldKey, @NotNull UUID uuid) {
+        this(null, worldKey, uuid);
     }
 
     /**
@@ -108,6 +125,16 @@ public class WorldCreator {
         return key;
     }
 
+    /**
+     * Gets the UUID to write for this world, if one was specified.
+     *
+     * @return the UUID, or null to use the stored/generated world UUID
+     */
+    @Nullable
+    public UUID uuid() {
+        return uuid;
+    }
+
     /**
      * Creates an empty WorldCreator for the given world name and key
      *
